apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: traefik-system
  annotations:
    external-dns.alpha.kubernetes.io/target: "{{ .Values.network.services.traefik.ip }}"
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`traefik.{{ .Values.network.domain }}`) && Path(`/`)
      kind: Rule
      services:
        - name: api@internal
          kind: TraefikService
      middlewares:
        - name: redirect-to-dashboard
          namespace: traefik-system 
    - match: Host(`traefik.{{ .Values.network.domain }}`) && (PathPrefix(`/dashboard`) || PathPrefix(`/api`))
      kind: Rule
      services:
        - name: api@internal
          kind: TraefikService
  tls: {}
