apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: traefik-system
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: (Host(`traefik.{{ index .Values "network" "domain" }}`) || Host(`traefik.{{ index .Values "network" "tls_domain" }}`)) && Path(`/`)
      kind: Rule
      services:
        - name: api@internal
          kind: TraefikService
      middlewares:
        - name: redirect-to-dashboard
          namespace: traefik-system 
    - match: (Host(`traefik.{{ index .Values "network" "domain" }}`) || Host(`traefik.{{ index .Values "network" "tls_domain" }}`)) && (PathPrefix(`/dashboard`) || PathPrefix(`/api`))
      kind: Rule
      services:
        - name: api@internal
          kind: TraefikService
  tls: {}
