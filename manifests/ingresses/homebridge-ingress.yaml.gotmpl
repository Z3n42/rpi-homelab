apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: homebridge-ui
  namespace: homebridge
  annotations:
    external-dns.alpha.kubernetes.io/target: "{{ .Values.network.services.traefik.ip }}"
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`homebridge.{{ .Values.network.domain }}`)
      kind: Rule
      services:
        - name: homebridge
          port: 8581

  tls: {}
