apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: pihole-dashboard
  namespace: pihole
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`pihole.{{ index .Values "network" "domain" }}`)
      kind: Rule
      services:
        - name: pihole-web
          port: 80
          namespace: pihole
  tls: {}
