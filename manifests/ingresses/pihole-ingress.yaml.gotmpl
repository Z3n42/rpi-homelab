apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: pihole-ui
  namespace: pihole
  annotations:
    external-dns.alpha.kubernetes.io/target: "{{ index .Values \"network\" \"services\" \"traefik\" \"ip\" }}"
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`pihole.{{ index .Values "network" "domain" }}`)
      kind: Rule
      services:
        - name: pihole-web
          port: 80
      middlewares:
        - name: pihole-headers
          namespace: pihole
  tls: {}
