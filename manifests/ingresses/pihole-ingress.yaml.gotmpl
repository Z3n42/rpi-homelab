apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: pihole-ui
  namespace: pihole
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`pihole.{{ index .Values "network" "tls_domain" }}`)
      kind: Rule
      middlewares:
        - name: pihole-headers
      services:
        - name: pihole-web
          port: 80

  tls: {}
