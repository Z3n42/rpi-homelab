resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: pihole-web-password
      namespace: pihole
    type: Opaque
    stringData:
      password: "{{ .Values.pihole.adminPassword }}"

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: unbound-config
      namespace: pihole
    data:
      unbound.conf: |
        server:
          verbosity: 1
          interface: 0.0.0.0
          port: 5335
          do-ip4: yes
          do-udp: yes
          do-tcp: yes
          do-ip6: no
          prefer-ip6: no
          access-control: 127.0.0.0/8 allow
          access-control: 10.0.0.0/8 allow
          access-control: 192.168.1.0/24 allow
          harden-glue: yes
          harden-dnssec-stripped: yes
          use-caps-for-id: no
          edns-buffer-size: 1232
          prefetch: yes
          num-threads: 1
          so-rcvbuf: 0
          so-sndbuf: 0
          private-domain: "local"
          private-domain: "lan"
          domain-insecure: "local"
          domain-insecure: "lan"
          private-address: 10.0.0.0/8
          private-address: 172.16.0.0/12
          private-address: 192.168.0.0/16

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: pihole-v6-config
      namespace: pihole
    data:
      pihole.toml: |
        [dns]
        upstreams = ["127.0.0.1#5335"]
        dnssec = true
        listeningMode = "all"

        [webserver]
        port = 80

        [database]
        maxDBdays = 30
        DBinterval = 60.0

        [gravity]
        updateFrequency = 7

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: pihole-custom-hosts
      namespace: pihole
    data:
      custom.hosts: |
        {{ .Values.network.services.traefik.ip }} traefik.{{ .Values.network.domain }}
        {{ .Values.network.services.cups.ip }} cups.{{ .Values.network.domain }}
        {{ .Values.network.services.homebridge.ip }} homebridge.{{ .Values.network.domain }}
        {{ .Values.network.services.pihole.web_ip }} pihole.{{ .Values.network.domain }}
        {{ .Values.network.node.zenpi_ip }} zenpi.{{ .Values.network.domain }}

  - apiVersion: v1
    kind: PersistentVolumeClaim
    metadata:
      name: pihole-pvc-v6
      namespace: pihole
    spec:
      accessModes:
        - ReadWriteOnce
      storageClassName: longhorn
      resources:
        requests:
          storage: 2Gi

  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: pihole-v6-init
      namespace: pihole
    spec:
      ttlSecondsAfterFinished: 300
      backoffLimit: 2
      template:
        metadata:
          labels:
            app: pihole-init
        spec:
          restartPolicy: Never
          containers:
            - name: cleanup-and-setup
              image: busybox:1.36
              command:
                - sh
                - -c
                - |
                  set -e

                  echo "Pi-hole v6 TOML Mode - PVC Initialization"

                  if [ -d /etc/pihole ]; then
                    ls -lah /etc/pihole/ 2>/dev/null || echo "  (empty)"
                  else
                    mkdir -p /etc/pihole
                  fi

                  if [ ! -f /tmp/source/pihole.toml ]; then
                    echo "ERROR: ConfigMap not mounted"
                    exit 1
                  fi

                  LEGACY_FILES="dnsmasq.conf setupVars.conf pihole-FTL.conf"
                  for file in $LEGACY_FILES; do
                    rm -f "/etc/pihole/$file"
                  done
                  rm -f /etc/pihole/*.conf.bak 2>/dev/null || true

                  mkdir -p /etc/dnsmasq.d
                  rm -rf /etc/dnsmasq.d/*

                  cp /tmp/source/pihole.toml /etc/pihole/pihole.toml
                  chmod 644 /etc/pihole/pihole.toml

                  echo "✅ Init completed"
                  cat /etc/pihole/pihole.toml
              volumeMounts:
                - name: pihole-storage
                  mountPath: /etc/pihole
                - name: dnsmasq-storage
                  mountPath: /etc/dnsmasq.d
                - name: config-source
                  mountPath: /tmp/source
              resources:
                requests:
                  cpu: "10m"
                  memory: "32Mi"
                limits:
                  cpu: "100m"
                  memory: "64Mi"
          volumes:
            - name: pihole-storage
              persistentVolumeClaim:
                claimName: pihole-pvc-v6
            - name: dnsmasq-storage
              emptyDir: {}
            - name: config-source
              configMap:
                name: pihole-v6-config

  - apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: pihole-v6
      namespace: pihole
      labels:
        app: pihole
    spec:
      replicas: 1
      strategy:
        type: Recreate
      selector:
        matchLabels:
          app: pihole
      template:
        metadata:
          labels:
            app: pihole
          annotations:
            secret-hash: "{{ .Values.pihole.adminPassword | sha256sum }}"
        spec:
          containers:
            - name: pihole
              image: pihole/pihole:2026.02.0
              imagePullPolicy: IfNotPresent
              env:
                - name: TZ
                  value: "Europe/Madrid"
                - name: DNSMASQ_LISTENING
                  value: "all"
                - name: FTLCONF_webserver_api_password
                  valueFrom:
                    secretKeyRef:
                      name: pihole-web-password
                      key: password
              ports:
                - containerPort: 53
                  name: domain-udp
                  protocol: UDP
                - containerPort: 53
                  name: domain-tcp
                  protocol: TCP
                - containerPort: 80
                  name: http
                  protocol: TCP
              volumeMounts:
                - name: pihole-storage
                  mountPath: /etc/pihole
                - name: dnsmasq-storage
                  mountPath: /etc/dnsmasq.d
                - name: pihole-logs
                  mountPath: /var/log/pihole
                - name: custom-hosts
                  mountPath: /etc/pihole/hosts
                  readOnly: true
              readinessProbe:
                tcpSocket:
                  port: 80
                initialDelaySeconds: 15
                periodSeconds: 10
                timeoutSeconds: 3
                failureThreshold: 6
              livenessProbe:
                tcpSocket:
                  port: 80
                initialDelaySeconds: 30
                periodSeconds: 30
                timeoutSeconds: 5
                failureThreshold: 3

            - name: unbound
              image: crazymax/unbound:1.24.0
              imagePullPolicy: IfNotPresent
              ports:
                - containerPort: 5335
                  name: unbound-udp
                  protocol: UDP
                - containerPort: 5335
                  name: unbound-tcp
                  protocol: TCP
              volumeMounts:
                - name: unbound-conf
                  mountPath: /etc/unbound/unbound.conf
                  subPath: unbound.conf
              resources:
                requests:
                  cpu: "50m"
                  memory: "128Mi"
                limits:
                  cpu: "200m"
                  memory: "256Mi"
              livenessProbe:
                tcpSocket:
                  port: 5335
                initialDelaySeconds: 30
                periodSeconds: 30
                timeoutSeconds: 3
                failureThreshold: 3
              readinessProbe:
                tcpSocket:
                  port: 5335
                initialDelaySeconds: 10
                periodSeconds: 10
                timeoutSeconds: 2
                failureThreshold: 3

          volumes:
            - name: pihole-storage
              persistentVolumeClaim:
                claimName: pihole-pvc-v6
            - name: dnsmasq-storage
              emptyDir: {}
            - name: pihole-logs
              emptyDir: {}
            - name: unbound-conf
              configMap:
                name: unbound-config
            - name: custom-hosts
              configMap:
                name: pihole-custom-hosts

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-dns
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.primary_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      externalTrafficPolicy: Local
      ports:
        - name: domain-udp
          port: 53
          protocol: UDP
          targetPort: 53
        - name: domain-tcp
          port: 53
          protocol: TCP
          targetPort: 53

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-web
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.web_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      ports:
        - name: http
          port: 80
          targetPort: 80
        - name: https
          port: 443
          targetPort: 443

  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: pihole-adlists-seed
      namespace: pihole
    spec:
      ttlSecondsAfterFinished: 300
      backoffLimit: 3
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: seed-adlists
              image: curlimages/curl:latest
              env:
                - name: PIHOLE_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: pihole-web-password
                      key: password
              command:
                - sh
                - -c
                - |
                  BASE="http://pihole-web.pihole.svc.cluster.local"

                  until curl -s "$BASE/api/auth" > /dev/null 2>&1; do
                    echo "Waiting for Pihole API..."
                    sleep 5
                  done

                  TOKEN=$(curl -sf -X POST "$BASE/api/auth" \
                    -H "Content-Type: application/json" \
                    -d '{"password":"'"$PIHOLE_PASSWORD"'"}' \
                    | grep -o '"sid":"[^"]*"' | cut -d'"' -f4)

                  COUNT=$(curl -sf "$BASE/api/lists?type=block" \
                    -H "sid: $TOKEN" \
                    | grep -o '"address"' | wc -l)

                  if [ "$COUNT" -gt 5 ]; then
                    echo "✅ Already has $COUNT lists, skipping"
                    exit 0
                  fi

                  echo "Seeding $COUNT lists..."
                  for URL in \
                    "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts" \
                    "https://big.oisd.nl" \
                    "https://blocklistproject.github.io/Lists/basic.txt" \
                    "https://v.firebog.net/hosts/static/w3kbl.txt" \
                    "https://adaway.org/hosts.txt" \
                    "https://v.firebog.net/hosts/AdguardDNS.txt" \
                    "https://v.firebog.net/hosts/Admiral.txt" \
                    "https://v.firebog.net/hosts/Easylist.txt" \
                    "https://v.firebog.net/hosts/Easyprivacy.txt" \
                    "https://v.firebog.net/hosts/Prigent-Ads.txt" \
                    "https://v.firebog.net/hosts/Prigent-Crypto.txt" \
                    "https://urlhaus.abuse.ch/downloads/hostfile/" \
                    "https://phishing.army/download/phishing_army_blocklist_extended.txt" \
                    "https://blocklistproject.github.io/Lists/ads.txt" \
                    "https://blocklistproject.github.io/Lists/malware.txt" \
                    "https://blocklistproject.github.io/Lists/phishing.txt" \
                    "https://blocklistproject.github.io/Lists/tracking.txt" \
                    "https://blocklistproject.github.io/Lists/abuse.txt" \
                    "https://blocklistproject.github.io/Lists/ransomware.txt" \
                    "https://raw.githubusercontent.com/PolishFiltersTeam/KADhosts/master/KADhosts.txt" \
                    "https://raw.githubusercontent.com/FadeMind/hosts.extras/master/add.Spam/hosts" \
                    "https://raw.githubusercontent.com/FadeMind/hosts.extras/master/add.2o7Net/hosts" \
                    "https://raw.githubusercontent.com/FadeMind/hosts.extras/master/add.Risk/hosts" \
                    "https://raw.githubusercontent.com/crazy-max/WindowsSpyBlocker/master/data/hosts/spy.txt" \
                    "https://raw.githubusercontent.com/Spam404/lists/master/main-blacklist.txt" \
                    "https://raw.githubusercontent.com/anudeepND/blacklist/master/adservers.txt" \
                    "https://raw.githubusercontent.com/bigdargon/hostsVN/master/hosts" \
                    "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt" \
                    "https://pgl.yoyo.org/adservers/serverlist.php?hostformat=hosts&showintro=0&mimetype=plaintext" \
                    "https://blocklistproject.github.io/Lists/scam.txt" \
                    "https://blocklistproject.github.io/Lists/fraud.txt" \
                    "https://blocklistproject.github.io/Lists/gambling.txt" \
                    "https://blocklistproject.github.io/Lists/crypto.txt" \
                    "https://blocklistproject.github.io/Lists/redirect.txt" \
                    "https://blocklistproject.github.io/Lists/smart-tv.txt" \
                    "https://blocklistproject.github.io/Lists/vaping.txt"
                    "https://github.com/blocklistproject/Lists/blob/master/youtube.txt" \
                    "https://gitlab.com/quidsup/notrack-blocklists/raw/master/notrack-malware.txt" \
                    "https://hostfiles.frogeye.fr/firstparty-trackers-hosts.txt" \
                    "https://lists.cyberhost.uk/malware.txt" \
                    "https://raw.githubusercontent.com/AssoEchap/stalkerware-indicators/master/generated/hosts" \
                    "https://raw.githubusercontent.com/DandelionSprout/adfilt/master/Alternate%20versions%20Anti-Malware%20List/AntiMalwareHosts.txt" \
                    "https://raw.githubusercontent.com/FadeMind/hosts.extras/master/UncheckyAds/hosts" \
                    "https://raw.githubusercontent.com/kboghdady/youTube_ads_4_pi-hole/master/youtubelist.txt" ; do
                    curl -sf -X POST "$BASE/api/lists" \
                      -H "Content-Type: application/json" \
                      -H "sid: $TOKEN" \
                      -d '{"address":"'"$URL"'","type":"block","enabled":true}' \
                      && echo "✅ $URL" || echo "⚠️ Failed: $URL"
                  done

                  curl -sf -X POST "$BASE/api/gravity" -H "sid: $TOKEN"
                  echo "✅ Gravity update triggered"


  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-headers
      namespace: pihole
    spec:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsSeconds: 31536000
        frameDeny: true
        contentSecurityPolicy: "frame-ancestors 'self'"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-redirect-http
      namespace: pihole
    spec:
      redirectScheme:
        scheme: https
        permanent: true
