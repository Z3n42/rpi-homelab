resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: pihole-web-password
      namespace: pihole
    type: Opaque
    stringData:
      password: {{ .Values.pihole.adminPassword | quote }}

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: unbound-config
      namespace: pihole
    data:
      unbound.conf: |
        server:
          verbosity: 1
          interface: 0.0.0.0
          port: 5335
          do-ip4: yes
          do-udp: yes
          do-tcp: yes
          do-ip6: no
          prefer-ip6: no
          access-control: 0.0.0.0/0 allow
          access-control: 127.0.0.0/8 allow
          harden-glue: yes
          harden-dnssec-stripped: yes
          use-caps-for-id: no
          edns-buffer-size: 1232
          prefetch: yes
          num-threads: 1
          so-rcvbuf: 1m
          so-sndbuf: 1m

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: pihole-v6-config
      namespace: pihole
    data:
      pihole.toml: |
        [dns]
        upstreams = ["unbound#5335"]
        dnssec = true
        [webserver]
        port = 80
        [adlists]
        sources = [
          "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
          "https://big.oisd.nl",
          "https://v.firebog.net/hosts/static/w3kbl.txt"
        ]

  - apiVersion: v1
    kind: PersistentVolumeClaim
    metadata:
      name: pihole-pvc-v6
      namespace: pihole
    spec:
      accessModes:
        - ReadWriteOnce
      storageClassName: longhorn
      resources:
        requests:
          storage: 2Gi

  - apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: pihole-v6
      namespace: pihole
      labels:
        app: pihole
    spec:
      replicas: 1
      strategy:
        type: Recreate
      selector:
        matchLabels:
          app: pihole
      template:
        metadata:
          labels:
            app: pihole
          annotations:
            secret-hash: "{{ .Values.pihole.adminPassword | sha256sum }}"
        spec:
          initContainers:
            - name: pihole-setup
              image: busybox:1.36
              command:
                - sh
                - -c
                - |
                  mkdir -p /etc/pihole
                  rm -f /etc/pihole/pihole.toml
                  cp /tmp/source/pihole.toml /etc/pihole/pihole.toml
                  chown -R 1000:1000 /etc/pihole
              volumeMounts:
                - name: storage
                  mountPath: /etc/pihole
                - name: config-source
                  mountPath: /tmp/source

          containers:
            - name: pihole
              image: pihole/pihole:latest
              imagePullPolicy: Always
              env:
                - name: TZ
                  value: "Europe/Madrid"
              ports:
                - containerPort: 53
                  name: domain-udp
                  protocol: UDP
                - containerPort: 53
                  name: domain-tcp
                  protocol: TCP
                - containerPort: 80
                  name: http
                  protocol: TCP
              volumeMounts:
                - name: storage
                  mountPath: /etc/pihole
              securityContext:
                capabilities:
                  add: ["NET_ADMIN", "NET_RAW"]
              resources:
                requests:
                  cpu: "100m"
                  memory: "256Mi"
                limits:
                  cpu: "500m"
                  memory: "512Mi"

            - name: unbound
              image: crazymax/unbound:latest
              ports:
                - containerPort: 5335
                  name: unbound-udp
                  protocol: UDP
              volumeMounts:
                - name: unbound-conf
                  mountPath: /etc/unbound/unbound.conf
                  subPath: unbound.conf
              securityContext:
                capabilities:
                  add: ["NET_BIND_SERVICE"]
                allowPrivilegeEscalation: false

            - name: pihole-password-setter
              image: pihole/pihole:latest
              command:
                - sh
                - -c
                - |
                  echo "Esperando a que Pi-hole esté listo..."
                  until nc -z localhost 80; do sleep 1; done
                  echo "Aplicando password desde Secret..."
                  pihole setpassword "$(cat /etc/pihole-password/password)"
                  echo "Password aplicado. Durmiendo para no reiniciar el pod..."
                  sleep infinity
              volumeMounts:
                - name: storage
                  mountPath: /etc/pihole
                - name: pihole-password
                  mountPath: /etc/pihole-password
                  readOnly: true

          volumes:
            - name: storage
              persistentVolumeClaim:
                claimName: pihole-pvc-v6
            - name: config-source
              configMap:
                name: pihole-v6-config
            - name: unbound-conf
              configMap:
                name: unbound-config
            - name: pihole-password
              secret:
                secretName: pihole-web-password

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-dns
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.primary_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      ports:
        - name: domain-udp
          port: 53
          protocol: UDP
          targetPort: 53
        - name: domain-tcp
          port: 53
          protocol: TCP
          targetPort: 53

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-web
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.web_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      ports:
        - name: http
          port: 80
          targetPort: 80

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-headers
      namespace: pihole
    spec:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsSeconds: 31536000

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-redirect-http
      namespace: pihole
    spec:
      redirectScheme:
        scheme: https
        permanent: true

  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: pihole-ingress
      namespace: pihole
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: web, websecure
        traefik.ingress.kubernetes.io/router.middlewares: pihole-pihole-headers@kubernetescrd, pihole-pihole-redirect-http@kubernetescrd
    spec:
      ingressClassName: traefik
      rules:
        - host: "pihole.{{ .Values.network.domain }}"
          http:
            paths:
              - path: /
                pathType: Prefix
                backend:
                  service:
                    name: pihole-web
                    port:
                      number: 80
      tls:
        - hosts:
            - "pihole.{{ .Values.network.domain }}"
