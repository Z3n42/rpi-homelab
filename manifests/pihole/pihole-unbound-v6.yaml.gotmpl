resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: pihole-web-password
      namespace: pihole
    type: Opaque
    stringData:
      password: "{{ .Values.pihole.adminPassword }}"

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: unbound-config
      namespace: pihole
    data:
      unbound.conf: |
        server:
          verbosity: 1
          interface: 0.0.0.0
          port: 5335
          do-ip4: yes
          do-udp: yes
          do-tcp: yes
          do-ip6: no
          prefer-ip6: no
          access-control: 127.0.0.0/8 allow
          access-control: 10.0.0.0/8 allow
          harden-glue: yes
          harden-dnssec-stripped: yes
          use-caps-for-id: no
          edns-buffer-size: 1232
          prefetch: yes
          num-threads: 1
          so-rcvbuf: 1m
          so-sndbuf: 1m
          private-address: 10.0.0.0/8
          private-address: 172.16.0.0/12
          private-address: 192.168.0.0/16

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: pihole-v6-config
      namespace: pihole
    data:
      pihole.toml: |
        [dns]
        upstreams = ["127.0.0.1#5335"]
        dnssec = true
        listeningMode = "all"
        
        [webserver]
        port = 80
        
        [adlists]
        sources = [
          "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
          "https://big.oisd.nl",
          "https://v.firebog.net/hosts/static/w3kbl.txt"
        ]

  - apiVersion: v1
    kind: PersistentVolumeClaim
    metadata:
      name: pihole-pvc-v6
      namespace: pihole
    spec:
      accessModes:
        - ReadWriteOnce
      storageClassName: longhorn
      resources:
        requests:
          storage: 2Gi

  - apiVersion: v1
    kind: PersistentVolumeClaim
    metadata:
      name: pihole-dnsmasq-pvc
      namespace: pihole
    spec:
      accessModes:
        - ReadWriteOnce
      storageClassName: longhorn
      resources:
        requests:
          storage: 100Mi

  # Critical initialization Job - must run BEFORE Deployment
  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: pihole-v6-init
      namespace: pihole
    spec:
      ttlSecondsAfterFinished: 300
      backoffLimit: 2
      template:
        metadata:
          labels:
            app: pihole-init
        spec:
          restartPolicy: Never
          containers:
            - name: cleanup-and-setup
              image: busybox:1.36
              command:
                - sh
                - -c
                - |
                  set -e
                  
                  echo "=================================================="
                  echo "Pi-hole v6 TOML Mode - PVC Initialization"
                  echo "=================================================="
                  echo ""
                  
                  echo "STEP 1: Verify initial PVC state"
                  echo "-------------------------------------------"
                  if [ -d /etc/pihole ]; then
                    echo "/etc/pihole contents:"
                    ls -lah /etc/pihole/ 2>/dev/null || echo "  (empty or inaccessible)"
                  else
                    echo "WARNING: /etc/pihole does not exist, creating..."
                    mkdir -p /etc/pihole
                  fi
                  echo ""
                  
                  echo "STEP 2: Verify mounted ConfigMap"
                  echo "---------------------------------------"
                  if [ -f /tmp/source/pihole.toml ]; then
                    echo "ConfigMap mounted correctly at /tmp/source/"
                    echo "pihole.toml contents:"
                    cat /tmp/source/pihole.toml
                  else
                    echo "ERROR: /tmp/source/pihole.toml DOES NOT EXIST"
                    echo "ConfigMap was not mounted properly"
                    exit 1
                  fi
                  echo ""
                  
                  echo "STEP 3: Remove legacy files"
                  echo "-------------------------------------"
                  LEGACY_FILES="dnsmasq.conf setupVars.conf pihole-FTL.conf"
                  for file in $LEGACY_FILES; do
                    if [ -f "/etc/pihole/$file" ]; then
                      echo "  Removing: $file"
                      rm -f "/etc/pihole/$file"
                    else
                      echo "  Not found: $file"
                    fi
                  done
                  
                  # Remove old backups
                  if ls /etc/pihole/*.conf.bak 1> /dev/null 2>&1; then
                    echo "  Removing: *.conf.bak files"
                    rm -f /etc/pihole/*.conf.bak
                  fi
                  echo ""
                  
                  echo "STEP 4: Clean /etc/dnsmasq.d"
                  echo "----------------------------------"
                  if [ -d /etc/dnsmasq.d ]; then
                    rm -rf /etc/dnsmasq.d/*
                    echo "  /etc/dnsmasq.d cleaned"
                  else
                    mkdir -p /etc/dnsmasq.d
                    echo "  /etc/dnsmasq.d created"
                  fi
                  echo ""
                  
                  echo "STEP 5: Copy pihole.toml"
                  echo "------------------------------"
                  cp /tmp/source/pihole.toml /etc/pihole/pihole.toml
                  chmod 644 /etc/pihole/pihole.toml
                  echo "  pihole.toml copied and permissions set"
                  echo ""
                  
                  echo "STEP 6: Final verification"
                  echo "------------------------------"
                  echo "Final /etc/pihole contents:"
                  ls -lah /etc/pihole/
                  echo ""
                  
                  echo "Installed pihole.toml contents:"
                  cat /etc/pihole/pihole.toml
                  echo ""
                  
                  echo "=================================================="
                  echo "INITIALIZATION COMPLETED"
                  echo "=================================================="
                  echo "PVC is ready for Pi-hole v6 in TOML mode"
                  echo "No legacy files present to force dnsmasq mode"
                  echo "=================================================="
              volumeMounts:
                - name: pihole-storage
                  mountPath: /etc/pihole
                - name: dnsmasq-storage
                  mountPath: /etc/dnsmasq.d
                - name: config-source
                  mountPath: /tmp/source
              resources:
                requests:
                  cpu: "10m"
                  memory: "32Mi"
                limits:
                  cpu: "100m"
                  memory: "64Mi"
          volumes:
            - name: pihole-storage
              persistentVolumeClaim:
                claimName: pihole-pvc-v6
            - name: dnsmasq-storage
              persistentVolumeClaim:
                claimName: pihole-dnsmasq-pvc
            - name: config-source
              configMap:
                name: pihole-v6-config

  - apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: pihole-v6
      namespace: pihole
      labels:
        app: pihole
    spec:
      replicas: 1
      strategy:
        type: Recreate
      selector:
        matchLabels:
          app: pihole
      template:
        metadata:
          labels:
            app: pihole
          annotations:
            secret-hash: "{{ .Values.pihole.adminPassword | sha256sum }}"
        spec:
          containers:
            - name: pihole
              image: pihole/pihole:2025.11.1
              imagePullPolicy: IfNotPresent
              env:
                - name: TZ
                  value: "Europe/Madrid"
                - name: DNSMASQ_LISTENING
                  value: "all"
              ports:
                - containerPort: 53
                  name: domain-udp
                  protocol: UDP
                - containerPort: 53
                  name: domain-tcp
                  protocol: TCP
                - containerPort: 80
                  name: http
                  protocol: TCP
              volumeMounts:
                - name: pihole-storage
                  mountPath: /etc/pihole
                - name: dnsmasq-storage
                  mountPath: /etc/dnsmasq.d
                - name: pihole-password
                  mountPath: /etc/pihole-password
                  readOnly: true
              lifecycle:
                postStart:
                  exec:
                    command:
                      - sh
                      - -c
                      - |
                        echo "[postStart] Ensuring FTL runtime directory exists..."
                        mkdir -p /run/pihole-ftl
                        chown pihole:pihole /run/pihole-ftl

                        echo "[postStart] Waiting for FTL process..."
                        for i in $(seq 1 300); do
                          if pgrep -x "pihole-FTL" >/dev/null; then
                            echo "[postStart] FTL process detected"
                            break
                          fi
                          sleep 1
                        done

                        echo "[postStart] Waiting for FTL socket..."
                        for i in $(seq 1 300); do
                          if [ -S /run/pihole-ftl/pihole-FTL.sock ]; then
                            echo "[postStart] FTL socket detected"
                            break
                          fi
                          sleep 1
                        done

                        PASSWORD=$(cat /etc/pihole-password/password)
                        echo "[postStart] Setting admin password..."
                        pihole setpassword "$PASSWORD" || echo "[postStart] WARNING: setpasswd failed"

                        echo "[postStart] Done"

            - name: unbound
              image: crazymax/unbound:1.24.0
              imagePullPolicy: IfNotPresent
              ports:
                - containerPort: 5335
                  name: unbound-udp
                  protocol: UDP
                - containerPort: 5335
                  name: unbound-tcp
                  protocol: TCP
              volumeMounts:
                - name: unbound-conf
                  mountPath: /etc/unbound/unbound.conf
                  subPath: unbound.conf
              resources:
                requests:
                  cpu: "50m"
                  memory: "128Mi"
                limits:
                  cpu: "200m"
                  memory: "256Mi"
              livenessProbe:
                tcpSocket:
                  port: 5335
                initialDelaySeconds: 30
                periodSeconds: 30
                timeoutSeconds: 3
                failureThreshold: 3
              readinessProbe:
                tcpSocket:
                  port: 5335
                initialDelaySeconds: 10
                periodSeconds: 10
                timeoutSeconds: 2
                failureThreshold: 3

          volumes:
            - name: pihole-storage
              persistentVolumeClaim:
                claimName: pihole-pvc-v6

            - name: dnsmasq-storage
              persistentVolumeClaim:
                claimName: pihole-dnsmasq-pvc

            - name: pihole-password
              secret:
                secretName: pihole-web-password

            - name: unbound-conf
              configMap:
                name: unbound-config

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-dns
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.primary_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      externalTrafficPolicy: Local
      ports:
        - name: domain-udp
          port: 53
          protocol: UDP
          targetPort: 53
        - name: domain-tcp
          port: 53
          protocol: TCP
          targetPort: 53

  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-web
      namespace: pihole
      annotations:
        metallb.universe.tf/address-pool: pihole-pool
        metallb.universe.tf/loadBalancerIPs: "{{ .Values.network.services.pihole.web_ip }}"
        metallb.universe.tf/allow-shared-ip: "pihole-shared"
    spec:
      selector:
        app: pihole
      type: LoadBalancer
      ports:
        - name: http
          port: 80
          targetPort: 80

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-headers
      namespace: pihole
    spec:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsSeconds: 31536000
        frameDeny: true
        contentSecurityPolicy: "frame-ancestors 'self'"

  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: pihole-redirect-http
      namespace: pihole
    spec:
      redirectScheme:
        scheme: https
        permanent: true

  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: pihole-ingress
      namespace: pihole
      annotations:
        traefik.ingress.kubernetes.io/router.entrypoints: web, websecure
        traefik.ingress.kubernetes.io/router.middlewares: pihole-pihole-headers@kubernetescrd, pihole-pihole-redirect-http@kubernetescrd
        cert-manager.io/cluster-issuer: letsencrypt-prod
    spec:
      ingressClassName: traefik
      rules:
        - host: "pihole.{{ .Values.network.domain }}"
          http:
            paths:
              - path: /
                pathType: Prefix
                backend:
                  service:
                    name: pihole-web
                    port:
                      number: 80
      tls:
        - hosts:
            - "pihole.{{ .Values.network.domain }}"
          secretName: pihole-tls-cert