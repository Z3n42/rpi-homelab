apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: traefik-system
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`traefik.{{ index .Values "network" "domain" }}`)
      kind: Rule
      services:
        - name: api@internal
          kind: TraefikService