resources:
  - apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: traefik-wildcard
      namespace: traefik-system
    spec:
      secretName: ingonzal-dev-tls
      issuerRef:
        name: letsencrypt-prod
        kind: ClusterIssuer
      dnsNames:
        - "{{ .Values.network.tls_domain }}"
        - "*.{{ .Values.network.tls_domain }}"
      duration: 2160h
      renewBefore: 720h
      privateKey:
        algorithm: ECDSA
        size: 256
        rotationPolicy: Always

  - apiVersion: traefik.io/v1alpha1
    kind: TLSStore
    metadata:
      name: default
      namespace: traefik-system
    spec:
      defaultCertificate:
        secretName: ingonzal-dev-tls
