# Wildcard certificate for *.ingonzal.dev
# Initially uses staging issuer — change to letsencrypt-prod once validated
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: ingonzal-dev-wildcard
  namespace: cert-manager
spec:
  secretName: ingonzal-dev-tls
  secretTemplate:
    annotations:
      # Allows other namespaces to reference this cert via Traefik TLS stores
      reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
      reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "traefik-system,pihole,homebridge,printing"
  issuerRef:
    name: letsencrypt-staging
    kind: ClusterIssuer
  commonName: "*.ingonzal.dev"
  dnsNames:
    - "ingonzal.dev"
    - "*.ingonzal.dev"
