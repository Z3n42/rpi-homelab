resources:
  - apiVersion: metallb.io/v1beta1
    kind: IPAddressPool
    metadata:
      name: default-pool
      namespace: metallb-system
    spec:
      addresses:
      - "{{ .Values.network.services.pihole.ip }}/32"
      - "{{ .Values.network.services.homebridge.ip }}/32"
      - "{{ .Values.network.metallb.range }}"

  - apiVersion: metallb.io/v1beta1
    kind: L2Advertisement
    metadata:
      name: default-l2
      namespace: metallb-system
    spec:
      ipAddressPools:
      - default-pool
