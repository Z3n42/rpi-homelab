resources:
  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-dns-tcp-lb
      namespace: pihole
      labels:
        app.kubernetes.io/name: pihole-lb
    spec:
      type: LoadBalancer
      loadBalancerIP: 192.168.1.53
      externalTrafficPolicy: Local
      selector:
        app.kubernetes.io/name: pihole
      ports:
      - name: dns-tcp
        port: 53
        targetPort: 53
        protocol: TCP
  - apiVersion: v1
    kind: Service
    metadata:
      name: pihole-dns-udp-lb
      namespace: pihole
      labels:
        app.kubernetes.io/name: pihole-lb
    spec:
      type: LoadBalancer
      loadBalancerIP: 192.168.1.53
      externalTrafficPolicy: Local
      selector:
        app.kubernetes.io/name: pihole
      ports:
      - name: dns-udp
        port: 53
        targetPort: 53
        protocol: UDP
