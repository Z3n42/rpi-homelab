replicaCount: 1

serviceDhcp:
  enabled: false

persistentVolumeClaim:
  enabled: true
  storageClass: longhorn
  accessModes:
    - ReadWriteMany
  size: 2Gi

pihole:
  dns1: "unbound-main.pihole.svc.cluster.local"
  dns2: "no"
  dnsmasq:
    upstreamServers:
      - "server=unbound-main.pihole.svc.cluster.local#5335"
  interface: "eth0"
  IPv6: "True"
  DNSSEC: "false"

  gravity:
    enabled: true
    blocklists:
      - https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
      - https://big.oisd.nl  # 2.5M dominios
      - https://v.firebog.net/hosts/static/w3kbl.txt

serviceDns:
  enabled: true
  mixedService: true
  type: LoadBalancer
  loadBalancerIP: "{{ .Values.network.services.pihole.primary_ip }}"
  externalTrafficPolicy: Local
  ports:
    - name: dns-tcp
      port: 53
      protocol: TCP
    - name: dns-udp
      port: 53
      protocol: UDP
    - name: http
      port: 80
      targetPort: 80
      protocol: TCP
    - name: https
      port: 443
      targetPort: 443
      protocol: TCP

probes:
  liveness:
    initialDelaySeconds: 120
    timeoutSeconds: 5
    failureThreshold: 10
  readiness:
    initialDelaySeconds: 60
    timeoutSeconds: 5
    failureThreshold: 5
